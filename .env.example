# Server
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dsa_platform?sslmode=require"

# JWT
JWT_ACCESS_SECRET="change_this_access_secret"
JWT_REFRESH_SECRET="change_this_refresh_secret"
ACCESS_TOKEN_EXPIRES="15m"
REFRESH_TOKEN_EXPIRES="7d"

# Client
CLIENT_URL="http://localhost:3000"

# Pramaan Identity Provider (OAuth 2.0 / OIDC)
# Base URL of the Pramaan IdP server (e.g., http://localhost:4000 or https://pramaan.example.com)
PRAMAAN_ISSUER="http://localhost:4000"

# Registered OAuth Client ID and Secret in Pramaan
PRAMAAN_CLIENT_ID="patterniq_client_id"
PRAMAAN_CLIENT_SECRET="patterniq_client_secret"

# Authorized redirect callback URI is automatically computed from the system/request host:
# e.g., https://patterniq-kappa.vercel.app/api/v1/auth/pramaan/callback (in production)
# or http://localhost:3000/api/v1/auth/pramaan/callback (in development)
# PRAMAAN_REDIRECT_URI is no longer needed in .env!
